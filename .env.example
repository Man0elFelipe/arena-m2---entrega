# Configuração local da Arena+ (copie este arquivo para ".env" e preencha).
# O arquivo ".env" NÃO é versionado (está no .gitignore). Nunca coloque chaves reais neste exemplo.

# --- Arena Coach (IA) -------------------------------------------------------
# Chave da API do provedor de IA. Sem ela o Coach fica desativado ("Coach não configurado no servidor").
# Onde criar a chave da OpenAI: https://platform.openai.com/api-keys  (a conta precisa ter saldo/crédito)
ARENAPLUS_COACH_API_KEY=

# Opcionais (os valores abaixo já são os padrões):
# ARENAPLUS_COACH_MODEL=gpt-4o-mini
# ARENAPLUS_COACH_BASE_URL=https://api.openai.com/v1
